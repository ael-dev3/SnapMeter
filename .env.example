# Collector RPC endpoints. Keep native gRPC private and firewalled.
# Hypersnap also uses internal port 3383; 4383 is only the documented host remap.
SNAPCHAIN_GRPC_URL=127.0.0.1:3383
HYPERSNAP_GRPC_URL=127.0.0.1:4383
SNAPCHAIN_GRPC_TLS=false
HYPERSNAP_GRPC_TLS=false
# Optional exact identity pins for the preferred local Hypersnap endpoint. Once
# first accepted, endpoint identity is also enrolled in the collector database.
HYPERSNAP_EXPECTED_PEER_ID=
HYPERSNAP_EXPECTED_VERSION=
# Optional complete authorization metadata values for authenticated proxies.
SNAPCHAIN_GRPC_AUTHORIZATION=
HYPERSNAP_GRPC_AUTHORIZATION=
# Optional x-api-key metadata values for hosted providers such as Neynar.
SNAPCHAIN_GRPC_API_KEY=
HYPERSNAP_GRPC_API_KEY=
# Minimum delay between GetEvents request starts. Use 250ms (4 RPS) for Neynar Starter.
SNAPCHAIN_RPC_MIN_INTERVAL_MS=0
HYPERSNAP_RPC_MIN_INTERVAL_MS=0
# Keep local/public Hypersnap probes bounded even if Snapchain needs a longer
# hosted-provider timeout.
HYPERSNAP_RPC_TIMEOUT_MS=5000
SNAPCHAIN_SOURCE_MODE=verified
# Keep derived unless a dedicated verified Hyper-write source is implemented.
HYPERSNAP_SOURCE_MODE=derived

# Ordered Hypersnap replica policy: prefer local gRPC, use the reviewed public
# HTTPS canonical-event API only while local is unavailable, then return local
# after consecutive healthy probes. The public peer/version are not secrets.
HYPERSNAP_FALLBACK_HTTP_URL=https://haatz.quilibrium.com
HYPERSNAP_FALLBACK_EXPECTED_PEER_ID=12D3KooWMYfkXiNcn9LifPkLYiHtGmXYnknYG1yFBD53rUseUMUc
HYPERSNAP_FALLBACK_EXPECTED_VERSION=0.13.3
HYPERSNAP_FALLBACK_POLL_INTERVAL_MS=5000
HYPERSNAP_FALLBACK_RPC_MIN_INTERVAL_MS=1000
HYPERSNAP_FAILOVER_AFTER_FAILURES=3
HYPERSNAP_PREFERRED_RECOVERY_INTERVAL_MS=60000
HYPERSNAP_PREFERRED_RECOVERY_SUCCESSES=3
HYPERSNAP_MAX_BLOCK_DELAY_SECONDS=30

# Public Worker ingest endpoint and shared HMAC secret.
SNAPMETER_INGEST_URL=
SNAPMETER_INGEST_SECRET=
# Defaults to %LOCALAPPDATA%\SnapMeter on Windows.
SNAPMETER_DATA_DIR=
SNAPMETER_LOG_LEVEL=info
SNAPMETER_LOG_RETENTION_DAYS=14
SNAPMETER_RPC_TIMEOUT_MS=10000
SNAPMETER_RECONCILE_INTERVAL_MS=30000
SNAPMETER_DISCOVERY_INTERVAL_MS=60000
SNAPMETER_SNAPSHOT_INTERVAL_MS=5000
SNAPMETER_PULSE_INTERVAL_MS=250
SNAPMETER_RETENTION_DAYS=35
SNAPMETER_BACKFILL_DAYS=31
SNAPMETER_STALE_AFTER_MS=30000
SNAPMETER_DISCONNECTED_AFTER_MS=120000
SNAPMETER_MAX_OUTBOX_ROWS=5000
# 512 MiB, expressed in bytes.
SNAPMETER_MIN_FREE_DISK_BYTES=536870912
