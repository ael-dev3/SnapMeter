# Collector RPC endpoints. Keep native gRPC private and firewalled.
# Hypersnap also uses internal port 3383; 4383 is only the documented host remap.
SNAPCHAIN_GRPC_URL=127.0.0.1:3383
HYPERSNAP_GRPC_URL=127.0.0.1:4383
SNAPCHAIN_GRPC_TLS=false
HYPERSNAP_GRPC_TLS=false
# Optional complete authorization metadata values for authenticated proxies.
SNAPCHAIN_GRPC_AUTHORIZATION=
HYPERSNAP_GRPC_AUTHORIZATION=
SNAPCHAIN_SOURCE_MODE=verified
# Keep derived unless a dedicated verified Hyper-write source is implemented.
HYPERSNAP_SOURCE_MODE=derived

# Public Worker ingest endpoint and shared HMAC secret.
SNAPMETER_INGEST_URL=
SNAPMETER_INGEST_SECRET=
# Defaults to %LOCALAPPDATA%\SnapMeter on Windows.
SNAPMETER_DATA_DIR=
SNAPMETER_LOG_LEVEL=info
SNAPMETER_LOG_RETENTION_DAYS=14
SNAPMETER_RPC_TIMEOUT_MS=10000
SNAPMETER_RECONCILE_INTERVAL_MS=30000
SNAPMETER_DISCOVERY_INTERVAL_MS=60000
SNAPMETER_SNAPSHOT_INTERVAL_MS=5000
SNAPMETER_PULSE_INTERVAL_MS=250
SNAPMETER_RETENTION_DAYS=35
SNAPMETER_BACKFILL_DAYS=31
SNAPMETER_STALE_AFTER_MS=30000
SNAPMETER_DISCONNECTED_AFTER_MS=120000
SNAPMETER_MAX_OUTBOX_ROWS=5000
# 512 MiB, expressed in bytes.
SNAPMETER_MIN_FREE_DISK_BYTES=536870912
