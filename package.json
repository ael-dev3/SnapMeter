{
  "name": "snapmeter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "collector": "pnpm --filter @snapmeter/collector collector",
    "dev": "pnpm --filter @snapmeter/dashboard dev",
    "lint": "eslint .",
    "security:check": "node scripts/check-publication-safety.mjs && pnpm audit --prod --audit-level high",
    "test": "vitest run && pnpm --filter @snapmeter/dashboard test && pnpm --filter @snapmeter/dashboard test:worker",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "pnpm --filter @snapmeter/dashboard test:e2e",
    "typecheck": "pnpm -r --if-present typecheck"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "26.5.1",
    "@vitest/coverage-v8": "5.0.0",
    "eslint": "10.10.0",
    "globals": "17.12.0",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.0"
  }
}
